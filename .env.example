# Copy to .env locally if you prefer dotenv tools. The Spring process reads OS env.
# Never commit a filled .env. Production passwords must not be tayviscon.

SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/tayviscon
SPRING_DATASOURCE_USERNAME=tayviscon
SPRING_DATASOURCE_PASSWORD=tayviscon
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_TOKEN=
# Optional blog repo override (defaults: tayviscon-io / tayviscon-knowledge-base / main)
# BLOG_GITHUB_OWNER=tayviscon-io
# BLOG_GITHUB_REPO=tayviscon-knowledge-base
# BLOG_GITHUB_REF=main
# Production HTTPS/VPS only. Leave unset/false for localhost HTTP.
# SERVER_SERVLET_SESSION_COOKIE_SECURE=true

# --- VPS /opt/tayviscon/.env (не копировать этот файл как есть) ---
# SITE_HOST=example.com
# SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/tayviscon
# SPRING_DATASOURCE_PASSWORD=сгенерировать-другой-пароль
# SERVER_SERVLET_SESSION_COOKIE_SECURE=true
# IMAGE_TAG=main
# GITHUB_TOKEN=fine-grained PAT Contents:Read on yet-another-course + tayviscon-knowledge-base
